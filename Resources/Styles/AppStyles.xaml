<!-- Resources/Styles/AppStyles.xaml -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- COLORS -->
    <Color x:Key="AppBg">#0A0F1E</Color>
    <Color x:Key="CardBg">#111827</Color>
    <Color x:Key="CardBgElevated">#1C2A3A</Color>
    <Color x:Key="SurfaceStroke">#1E293B</Color>
    <Color x:Key="InputBg">#1C2A3A</Color>

    <Color x:Key="PrimaryPurple">#7C3AED</Color>
    <Color x:Key="AccentBlue">#06B6D4</Color>
    <Color x:Key="AccentGreen">#22C55E</Color>
    <Color x:Key="AccentOrange">#F97316</Color>
    <Color x:Key="AccentGold">#FBBF24</Color>

    <Color x:Key="TextPrimary">#F1F5F9</Color>
    <Color x:Key="SoftText">#94A3B8</Color>
    <Color x:Key="MutedText">#475569</Color>
    <Color x:Key="DangerRed">#EF4444</Color>

    <!-- TEXT -->
    <Style x:Key="ScreenTitle" TargetType="Label">
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}"/>
    </Style>

    <Style x:Key="SubText" TargetType="Label">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="TextColor" Value="{StaticResource SoftText}"/>
    </Style>

    <Style x:Key="SectionHeader" TargetType="Label">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="CharacterSpacing" Value="2"/>
        <Setter Property="TextColor" Value="{StaticResource SoftText}"/>
    </Style>

    <!-- BUTTONS -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource PrimaryPurple}"/>
        <Setter Property="TextColor" Value="White"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="HeightRequest" Value="52"/>
        <Setter Property="FontAttributes" Value="Bold"/>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="#1E293B"/>
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="HeightRequest" Value="52"/>
        <Setter Property="FontAttributes" Value="Bold"/>
    </Style>

    <Style x:Key="DangerButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource DangerRed}"/>
        <Setter Property="TextColor" Value="White"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="HeightRequest" Value="52"/>
        <Setter Property="FontAttributes" Value="Bold"/>
    </Style>

    <!-- INPUTS -->
    <Style x:Key="InputBox" TargetType="Entry">
        <Setter Property="BackgroundColor" Value="{StaticResource InputBg}"/>
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}"/>
        <Setter Property="PlaceholderColor" Value="{StaticResource MutedText}"/>
    </Style>

    <Style x:Key="EditorBox" TargetType="Editor">
        <Setter Property="BackgroundColor" Value="{StaticResource InputBg}"/>
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}"/>
    </Style>

    <!-- CARD -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource CardBg}"/>
        <Setter Property="Stroke" Value="{StaticResource SurfaceStroke}"/>
        <Setter Property="StrokeThickness" Value="1"/>
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="20"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CardElevated" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource CardBgElevated}"/>
        <Setter Property="Stroke" Value="{StaticResource SurfaceStroke}"/>
        <Setter Property="StrokeThickness" Value="1"/>
    </Style>

    <!-- PROGRESS -->
    <Style x:Key="QuizProgress" TargetType="ProgressBar">
        <Setter Property="ProgressColor" Value="{StaticResource AccentBlue}"/>
        <Setter Property="HeightRequest" Value="8"/>
    </Style>

</ResourceDictionary>