<!-- Views/LearningMaterialPage.xaml -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Codelingo.Frontend.Views.LearningMaterialPage"
             Title="Learning Material"
             BackgroundColor="{StaticResource AppBg}">

    <ScrollView>
        <VerticalStackLayout Padding="20,24,20,32" Spacing="16">

            <Label Text="Learning Material"
                   Style="{StaticResource ScreenTitle}" />

            <Label Text="Save notes, articles, or code snippets"
                   Style="{StaticResource SubText}" />

            <Border BackgroundColor="{StaticResource CardBg}"
                    Stroke="{StaticResource PrimaryPurple}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 24"
                    Padding="20">

                <VerticalStackLayout Spacing="14">

                    <Label Text="ADD NEW"
                           Style="{StaticResource SectionHeader}" />

                    <Border BackgroundColor="{StaticResource InputBg}"
                            Stroke="{StaticResource SurfaceStroke}"
                            StrokeShape="RoundRectangle 14"
                            Padding="12,4">
                        <Entry x:Name="TitleEntry"
                               Placeholder="Material title..."
                               PlaceholderColor="{StaticResource SoftText}"
                               TextColor="{StaticResource TextPrimary}"
                               Style="{StaticResource InputBox}" />
                    </Border>

                    <Border BackgroundColor="{StaticResource InputBg}"
                            Stroke="{StaticResource SurfaceStroke}"
                            StrokeShape="RoundRectangle 14"
                            Padding="12,4">
                        <Editor x:Name="ContentEditor"
                                Placeholder="Paste your content here..."
                                PlaceholderColor="{StaticResource SoftText}"
                                TextColor="{StaticResource TextPrimary}"
                                HeightRequest="135"
                                AutoSize="Disabled"
                                Style="{StaticResource EditorBox}" />
                    </Border>

                    <Button Text="Save Material"
                            Clicked="OnSaveClicked"
                            Style="{StaticResource PrimaryButton}" />

                </VerticalStackLayout>
            </Border>

            <Label Text="SAVED MATERIALS"
                   Style="{StaticResource SectionHeader}" />

            <CollectionView x:Name="MaterialsCollection">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border BackgroundColor="{StaticResource CardBg}"
                                Stroke="{StaticResource SurfaceStroke}"
                                StrokeShape="RoundRectangle 18"
                                Padding="16"
                                Margin="0,6">

                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">

                                <VerticalStackLayout Grid.Column="0" Spacing="4">
                                    <Label Text="{Binding Title}"
                                           FontSize="15"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource TextPrimary}" />

                                    <Label Text="Tap Use to load into quiz generator"
                                           FontSize="12"
                                           TextColor="{StaticResource SoftText}" />
                                </VerticalStackLayout>

                                <Button Grid.Column="1"
                                        Text="Use"
                                        CommandParameter="{Binding .}"
                                        Clicked="OnUseClicked"
                                        BackgroundColor="{StaticResource PrimaryPurple}"
                                        TextColor="White"
                                        CornerRadius="12"
                                        HeightRequest="40"
                                        WidthRequest="58"
                                        FontSize="13"
                                        FontAttributes="Bold" />

                                <Button Grid.Column="2"
                                        Text="✕"
                                        CommandParameter="{Binding Id}"
                                        Clicked="OnDeleteClicked"
                                        BackgroundColor="{StaticResource DangerRed}"
                                        TextColor="White"
                                        CornerRadius="12"
                                        HeightRequest="40"
                                        WidthRequest="40"
                                        FontSize="13"
                                        FontAttributes="Bold" />

                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label x:Name="MessageLabel"
                   TextColor="#FCA5A5"
                   FontSize="14"
                   FontAttributes="Bold"
                   HorizontalTextAlignment="Center" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>