<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Codelingo.Frontend.Views.QuizPage"
             Title="Quiz"
             BackgroundColor="{StaticResource AppBg}">

    <VerticalStackLayout Padding="24" Spacing="18">
        <ProgressBar x:Name="ProgressBar" Progress="0" ProgressColor="{StaticResource AccentBlue}" />

        <Border BackgroundColor="{StaticResource CardBg}" StrokeShape="RoundRectangle 24" Padding="20">
            <VerticalStackLayout Spacing="16">
                <Label x:Name="ProgressLabel"
                       Text="Question 1"
                       TextColor="{StaticResource SoftText}"
                       FontAttributes="Bold"
                       HorizontalOptions="Center" />

                <Label x:Name="TimerLabel"
                       Text="15"
                       FontSize="34"
                       FontAttributes="Bold"
                       TextColor="{StaticResource AccentBlue}"
                       HorizontalOptions="Center" />

                <Label x:Name="QuestionLabel"
                       FontSize="22"
                       FontAttributes="Bold"
                       TextColor="White" />

                <VerticalStackLayout x:Name="OptionsLayout" Spacing="10" />

                <Label x:Name="MessageLabel" TextColor="#FCA5A5" />
            </VerticalStackLayout>
        </Border>
    </VerticalStackLayout>
</ContentPage>