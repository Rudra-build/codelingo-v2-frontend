<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Codelingo.Frontend.Views.LoginPage"
             BackgroundColor="{StaticResource AppBg}">

    <ScrollView>
        <VerticalStackLayout Padding="20,24,20,32"
                             Spacing="16"
                             VerticalOptions="Center">

            <Border Style="{StaticResource Card}" Padding="20">
                <VerticalStackLayout Spacing="14">

                    <!-- LOGO -->
                    <Border BackgroundColor="{StaticResource PrimaryPurple}"
                            WidthRequest="64"
                            HeightRequest="64"
                            HorizontalOptions="Center"
                            StrokeShape="RoundRectangle 18">
                        <Label Text="C"
                               FontSize="32"
                               FontAttributes="Bold"
                               TextColor="White"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                    </Border>

                    <Label Text="CodeLingo"
                           FontSize="32"
                           FontAttributes="Bold"
                           TextColor="{StaticResource TextPrimary}"
                           HorizontalOptions="Center"/>

                    <Label Text="Master code. One quiz at a time."
                           Style="{StaticResource SubText}"
                           HorizontalOptions="Center"/>

                    <Label Text="SIGN IN"
                           Style="{StaticResource SectionHeader}"/>

                    <Entry x:Name="EmailEntry"
                        Placeholder="Email address"
                        Keyboard="Email"
                        IsTextPredictionEnabled="False"
                        IsSpellCheckEnabled="False"
                        Style="{StaticResource InputBox}" />

                    <Entry x:Name="PasswordEntry"
                           Placeholder="Password"
                           IsPassword="True"
                           Style="{StaticResource InputBox}"/>

                    <Button Text="Continue"
                            Clicked="OnLoginClicked"
                            Style="{StaticResource PrimaryButton}"/>

                    <Button Text="Create an account"
                            Clicked="OnRegisterClicked"
                            Style="{StaticResource SecondaryButton}"/>

                    <Label x:Name="MessageLabel"
                           TextColor="{StaticResource DangerRed}"
                           HorizontalOptions="Center"/>

                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>